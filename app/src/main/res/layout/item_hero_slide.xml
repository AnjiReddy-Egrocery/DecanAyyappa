<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is drawn ON the image: image fills the slide, overlay sits at bottom-centre.
     Overlay = [translucent box: title + subtitle] then [buttons] below it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/heroImage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
       android:scaleType="fitXY" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Title + subtitle share ONE light transparent background -->
        <LinearLayout
            android:id="@+id/heroTextBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/hero_text_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:id="@+id/heroTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:textColor="#FFEED3"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Buttons at the bottom-middle of the image -->
        <LinearLayout
            android:id="@+id/heroButtonRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/heroPrimaryBtn"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:background="@drawable/hero_btn_secondary_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#FFEED3"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/heroSecondaryBtn"
                android:layout_width="wrap_content"
                android:layout_height="50dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/hero_btn_secondary_bg"
                android:gravity="center"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#FFEED3"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
